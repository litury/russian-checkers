[Unit]
Description=Consistent backup of the damka PostgreSQL database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/damka-backup/backupDatabase.py
TimeoutStartSec=240
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true

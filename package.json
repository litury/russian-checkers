{
	"name": "russian-checkers",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:api": "node tools/dev.mjs api",
		"dev:all": "node tools/dev.mjs all",
		"typecheck": "tsc --noEmit && npm --prefix server run typecheck",
		"typecheck:watch": "node tools/dev.mjs types",
		"verify": "npm run check:boundaries && npm run typecheck && vite build",
		"check:boundaries": "node tools/checkBoundaries.mjs",
		"build": "tsc --noEmit && vite build",
		"check": "biome check ."
	},
	"dependencies": {
		"phaser": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.2",
		"vite": "^8.2.0"
	}
}

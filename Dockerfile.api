FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json server/package-lock.json ./server/
RUN npm ci && cd server && npm ci
COPY src/rules ./src/rules
COPY src/online ./src/online
COPY server ./server
ENV PORT=8787
EXPOSE 8787
CMD ["./node_modules/.bin/vite-node", "server/src/index.ts"]
